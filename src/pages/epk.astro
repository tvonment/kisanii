---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import ClickToPlayVideo from '../components/ClickToPlayVideo.astro';
import BandsintownConcerts from '../components/BandsintownConcerts.astro';
import { t, type UIKey } from '../i18n/ui';

const lang = 'de';

const liveVideos: { slug: string; key: UIKey }[] = [
  { slug: 'live-chor', key: 'epk.liveVideo' },
  { slug: 'live-band', key: 'epk.fullBandVideo' },
];

const pressGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/images/pressefotos/*.{jpg,jpeg}', { eager: true });
const pressPhotos = Object.entries(pressGlob)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([key, m]) => ({
    img: m.default,
    downloadUrl: `/press/${key.split('/').pop()}`,
  }));
const portrait = pressPhotos[0]?.img;
---

<BaseLayout
  title={t(lang, 'epk.title')}
  description={t(lang, 'epk.description')}
  noindex={true}
  lang={lang}
>
  <!-- ── VIDEO ─────────────────────────────────────────────── -->
  <section class="section-gap" style="background: var(--color-bg);">
    <div class="site-container">
      <div class="text-center max-w-2xl mx-auto mb-8 flex flex-col gap-3">
        <p class="text-xs uppercase tracking-[0.3em] font-semibold" style="color: var(--color-accent);">
          Electronic Press Kit
        </p>
        <h1 class="font-display text-4xl sm:text-5xl font-bold">KISANII</h1>
        <p class="text-base leading-relaxed" style="color: var(--color-fg-muted);">
          {t(lang, 'epk.subtitle')}
        </p>
      </div>
      <VideoPlayer src="/video/epk.mp4" class="max-w-4xl mx-auto" />
      <div class="flex flex-wrap justify-center gap-6 mt-6 text-sm" style="color: var(--color-fg-muted);">
        <span><strong style="color: var(--color-fg);">Lea von Mentlen</strong></span>
        <a href="mailto:booking@kisanii.ch" class="transition-colors hover:underline" style="color: var(--color-fg-muted);">booking@kisanii.ch</a>
        <a href="tel:+41774366606" class="transition-colors hover:underline" style="color: var(--color-fg-muted);">+41 77 436 66 06</a>
      </div>
    </div>
  </section>

  <!-- ── KEY FACTS ──────────────────────────────────────────── -->
  <section style="background: var(--color-surface);">
    <div class="site-container py-8">
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto">
        {
          [
            { label: 'Herkunft', value: 'Schweiz' },
            { label: 'Genre', value: 'Singer-Songwriter' },
            { label: 'Sprache', value: 'Deutsch' },
            { label: 'Label', value: 'Independent' },
          ].map(({ label, value }) => (
            <div class="flex flex-col gap-1">
              <dt class="text-xs uppercase tracking-widest" style="color: var(--color-fg-muted);">{label}</dt>
              <dd class="font-display text-lg font-semibold">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ── ZITATE ─────────────────────────────────────────── -->
  <section class="section-gap">
    <div class="site-container flex flex-col gap-8 max-w-2xl mx-auto">
      <blockquote class="card p-8 border-l-4" style="border-left-color: var(--color-accent);">
        <p class="font-display text-xl font-medium leading-relaxed mb-4">
          «Kisanii nimmt ihre Hörerinnen und Hörer mit auf eine Reise — verletzlich, ehrlich und unwiderstehlich authentisch.»
        </p>
        <footer class="text-xs uppercase tracking-widest" style="color: var(--color-fg-muted);">
          Saarländischer Rundfunk (SR) · April 2025
        </footer>
      </blockquote>
      <blockquote class="card p-8 border-l-4" style="border-left-color: var(--color-accent);">
        <p class="font-display text-xl font-medium leading-relaxed mb-4">
          «Die Tränen liefen schon, bevor der Vorhang geöffnet war.»
        </p>
        <footer class="text-xs uppercase tracking-widest" style="color: var(--color-fg-muted);">
          Eine Konzertbesucherin
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ── BIO ────────────────────────────────────────────────── -->
  <section class="section-gap">
    <div class="site-container">
      <SectionHeading text={t(lang, 'section.bio')} />
      <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto items-start">
        <div class="flex flex-col gap-5">
          <p class="text-base leading-relaxed" style="color: var(--color-fg-muted);">
            {t(lang, 'bio.text')}
          </p>
          <p class="text-base leading-relaxed" style="color: var(--color-fg-muted);">
            Mit ihrem Debüt-EP <strong style="color: var(--color-fg);">«Cycle»</strong> (2025) und Singles
            wie <strong style="color: var(--color-fg);">«Tailwind»</strong> und
            <strong style="color: var(--color-fg);">«Victress»</strong> hat sie eine treue Hörerschaft
            aufgebaut — und das Interesse der Medien geweckt. Im April 2025 war sie zu Gast beim
            dem Saarländischen Rundfunk (SR).
          </p>
          <div class="flex flex-wrap gap-3 mt-1">
            <a href="https://open.spotify.com/artist/7jMnqSsKuIzLzjgIPtgbwu" target="_blank" rel="noopener noreferrer" class="btn btn-outline text-xs">Spotify</a>
            <a href="https://music.apple.com/nl/artist/kisanii/1727114509" target="_blank" rel="noopener noreferrer" class="btn btn-outline text-xs">Apple Music</a>
            <a href="https://www.instagram.com/kisanii.music/" target="_blank" rel="noopener noreferrer" class="btn btn-outline text-xs">Instagram</a>
          </div>
        </div>
        <div class="relative rounded-lg overflow-hidden" style="aspect-ratio: 3/4;">
          {portrait && (
            <Image
              src={portrait}
              alt={t(lang, 'bio.portrait.alt')}
              class="w-full h-full object-cover"
              loading="eager"
              widths={[500, 900]}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── LIVE-VIDEO ─────────────────────────────────────────── -->
  <section class="section-gap" style="background: var(--color-surface);">
    <div class="site-container">
      <SectionHeading text="Videos" />
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {liveVideos.map(({ slug, key }) => (
          <figure>
            <ClickToPlayVideo src={`/video/${slug}.mp4`} poster={`/video/${slug}.jpg`} title={t(lang, key)} lang={lang} />
            <figcaption class="mt-3 text-xs uppercase tracking-widest text-center" style="color: var(--color-fg-muted);">
              {t(lang, key)}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── MUSIK ──────────────────────────────────────────────── -->
  <section class="section-gap" style="background: var(--color-surface);">
    <div class="site-container">
      <SectionHeading text={t(lang, 'section.music')} />
      <div class="max-w-2xl mx-auto flex flex-col gap-6">
        <!-- SoundCloud embed -->
        <div>
          <p class="text-xs uppercase tracking-widest mb-3" style="color: var(--color-fg-muted);">SoundCloud</p>
          <iframe
            style="border-radius: 12px;"
            src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/2334435537%3Fsecret_token%3Ds-zUhjVsH71sx&color=%23ea6632&visual=true&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&show_playcount=false&sharing=false&download=false&buying=false"
            width="100%"
            height="450"
            frameborder="0"
            allow="autoplay; encrypted-media"
            loading="lazy"
            title="Inner Revolutions von Kisanii auf SoundCloud"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PRESSE ─────────────────────────────────────────────── -->
  <section class="section-gap">
    <div class="site-container">
      <SectionHeading text="Presse & Medien" />

      {pressPhotos.length > 0 && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
          {pressPhotos.map(({ img, downloadUrl }) => (
            <div class="relative rounded-lg overflow-hidden" style="aspect-ratio: 1;">
              <Image
                src={img}
                alt={t(lang, 'bio.portrait.alt')}
                class="w-full h-full object-cover"
                loading="lazy"
                widths={[400, 700]}
                sizes="(min-width: 640px) 33vw, 50vw"
              />
              <a
                href={downloadUrl}
                download
                aria-label="Foto herunterladen"
                class="absolute bottom-2 right-2 p-2 rounded-md transition-opacity opacity-60 hover:opacity-100"
                style="background: rgba(14,11,11,0.7);"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
              </a>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── LIVE ───────────────────────────────────────────────── -->
  <section class="section-gap" style="background: var(--color-surface);">
    <div class="site-container">
      <SectionHeading text="Live" />
      <div class="max-w-3xl mx-auto">
        <BandsintownConcerts lang={lang} labels={{ upcoming: 'Bevorstehend', past: 'Vergangene Auftritte' }} />
      </div>
    </div>
  </section>

  <!-- ── BOOKING ────────────────────────────────────────────── -->
  <section class="section-gap">
    <div class="site-container">
      <SectionHeading text={t(lang, 'epk.booking')} />
      <div class="card p-8 max-w-2xl mx-auto flex flex-col gap-6">
        <p class="text-base leading-relaxed" style="color: var(--color-fg-muted);">
          Für Buchungsanfragen, Interviews, Pressefotos in Druckqualität und weitere Informationen
          steht das Team von Kisanii gerne zur Verfügung.
        </p>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="flex flex-col gap-1">
            <span class="text-xs uppercase tracking-widest" style="color: var(--color-fg-muted);">Kontakt</span>
            <span class="font-semibold" style="color: var(--color-fg);">Lea von Mentlen</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs uppercase tracking-widest" style="color: var(--color-fg-muted);">E-Mail</span>
            <a href="mailto:booking@kisanii.ch" class="font-semibold transition-colors" style="color: var(--color-fg);">booking@kisanii.ch</a>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs uppercase tracking-widest" style="color: var(--color-fg-muted);">Telefon</span>
            <a href="tel:+41774366606" class="font-semibold transition-colors" style="color: var(--color-fg);">+41 77 436 66 06</a>
          </div>
        </div>
        <a href="mailto:booking@kisanii.ch" class="btn btn-accent self-start">
          Anfrage senden →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

